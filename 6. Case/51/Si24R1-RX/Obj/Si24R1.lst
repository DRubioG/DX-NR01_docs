 241          //Si24R1初始化函数
 242          void Si24R1_Init(void)
 243          {
 244   1        while(Si24R1_Check())
 245   1        {
 246   2          printf("No Si24R1 Error\r\n");
 247   2          //delay_ms(50);
 248   2        }
 249   1        
 250   1        
 251   1        CE=0;
 252   1        Si24R1_Write_Reg(NRF_WRITE_REG+RX_PW_P0,R_RX_PAYLOAD_WIDTH);        //选择通道0的有效数据宽度       
 253   1        Si24R1_Write_Buf(NRF_WRITE_REG+TX_ADDR,(uchar*)TX_ADDRESS,TX_ADDR_WIDTH);   //写TX节点地址 
 254   1        Si24R1_Write_Buf(NRF_WRITE_REG+RX_ADDR_P0,(uchar*)RX_ADDRESS,RX_ADDR_WIDTH);  //写 Rx 节点的地址（主要是为
             -了使能 Auto Ack）
 255   1        Si24R1_Write_Reg(NRF_WRITE_REG+EN_AA,0x01);     //使能 AUTO ACK EN_AA  开启自动应答
 256   1        Si24R1_Write_Reg(NRF_WRITE_REG+EN_RXADDR,0x01);   //使能通道0的接收地址  
 257   1        Si24R1_Write_Reg(NRF_WRITE_REG+SETUP_RETR,0x03);  //250us重发延时，自动重发3次
 258   1        Si24R1_Write_Reg(NRF_WRITE_REG+RF_CH,2);           //2402MHZ
 259   1        Si24R1_Write_Reg(NRF_WRITE_REG+RF_SETUP,0x0f);    //2Mbps,7dbm
 260   1        Si24R1_Write_Reg(NRF_WRITE_REG+CONFIG,0x0f);     //配置基本工作模式的参数;PWR_UP,EN_CRC,16BIT_CRC,接收模式,
             -开启所有中断
 261   1        delay_ms(20);
 262   1        CE=1;
 263   1        
 264   1      }
 265          
 266          
 267          void RF_RX_Init(void)
 268          {
 269   1        
 270   1        init_io();
 271   1        Si24R1_Init();
 272   1        Si24R1_RX_Mode();
 273   1      }


