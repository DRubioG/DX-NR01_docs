 100          //Si24R1写数据
 101          //reg:寄存器(位置)
 102          //*pBuf:数据指针
 103          //len:数据长度
 104          //返回值,此次读到的状态寄存器值
 105          uchar Si24R1_Write_Buf(uchar reg, uchar *pBuf, uchar len)
 106          {
 107   1      
 108   1        uchar status,ctr;
 109   1        CSN=0;             //使能SPI传输          
 110   1        status=SW_SPI_ReadWriteByte(reg); //发送寄存器值(位置),并读取状态值
 111   1        for(ctr=0;ctr<len;ctr++)
 112   1        {
 113   2          SW_SPI_ReadWriteByte(*pBuf++);  //写入数据   
 114   2        
 115   2        
 116   2        }
C51 COMPILER V9.54   SI24R1                                                                12/13/2024 15:01:19 PAGE 3   

 117   1        CSN=1;            //SPI传输结束
 118   1        return(status);             //返回状态值
 119   1      }
 120          
 121          
 122          //Si24R1读数据
 123          //reg:寄存器(位置)
 124          //*pBuf:数据指针
 125          //len:数据长度
 126          //返回值,此次读到的状态寄存器值
 127          uchar Si24R1_Read_Buf(uchar reg, uchar *pBuf, uchar len)
 128          {
 129   1        uchar status,u8_ctr;
 130   1        CSN=0;  
 131   1        status=SW_SPI_ReadWriteByte(reg);
 132   1        for(u8_ctr=0;u8_ctr<len;u8_ctr++)
 133   1        {
 134   2          pBuf[u8_ctr]=SW_SPI_ReadWriteByte(0xff);  //读数据   
 135   2        
 136   2        
 137   2        }
 138   1        CSN=1;            //SPI传输结束
 139   1        return status;            //返回状态值
 140   1      
 141   1      }
