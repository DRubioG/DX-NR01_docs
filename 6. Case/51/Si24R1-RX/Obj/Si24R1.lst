 196          //设置Si24R1为TX模式
 197          void Si24R1_TX_Mode(void)
 198          {
 199   1      
 200   1        CE=0;
 201   1        Si24R1_Write_Reg(NRF_WRITE_REG+CONFIG,0x0e);
 202   1          Si24R1_Write_Reg(FLUSH_RX,0xff);
 203   1        Si24R1_Write_Reg(FLUSH_TX,0xff);
 204   1        CE=1;
 205   1      
 206   1      }
 207          
 208          
 209          //设置Si24R1为RX模式
 210          void Si24R1_RX_Mode(void)
 211          {
 212   1      
 213   1        CE=0;
 214   1        Si24R1_Write_Reg(NRF_WRITE_REG+CONFIG,0x0f);
 215   1          Si24R1_Write_Reg(FLUSH_RX,0xff);
 216   1        Si24R1_Write_Reg(FLUSH_TX,0xff);
 217   1        CE=1;
 218   1      
 219   1      }
