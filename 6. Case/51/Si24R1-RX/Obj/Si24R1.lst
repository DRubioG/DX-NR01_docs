 221          //Si24R1检测函数
 222          uchar Si24R1_Check(void)
 223          {
 224   1        uchar check_in_data[5]={0X55,0XAA,0X55,0XAA,0X55};
 225   1        uchar check_out_data[5]={0x00};
 226   1        
 227   1        CE=0;
 228   1        Si24R1_Write_Buf(NRF_WRITE_REG+TX_ADDR,check_in_data,5);
 229   1        Si24R1_Read_Buf(NRF_READ_REG+TX_ADDR,check_out_data,5);
 230   1        if( (check_out_data[0]==0x55)&&
 231   1          (check_out_data[1]==0xAA)&&
 232   1          (check_out_data[2]==0x55)&&
 233   1          (check_out_data[3]==0xAA)&&
 234   1          (check_out_data[4]==0x55))
 235   1          return 0;
 236   1        else
 237   1          return 1;
 238   1      }
