 146          //启动Si24R1发送一次数据
 147          //txbuf:待发送数据首地址
 148          //返回值:发送完成状况
 149          uchar Si24R1_TxPacket(uchar *txbuf)
 150          {
 151   1        uchar sta;
 152   1        CE=0;
 153   1        Si24R1_Write_Buf(WR_TX_PLOAD,txbuf,W_RX_PAYLOAD_WIDTH); //写数据到TX BUF  32个字节
 154   1        CE=1;
 155   1          
 156   1        while(IRQ!=0);                           //数据发送完成中断
 157   1        sta=Si24R1_Read_Reg(STATUS);           //读取状态寄存器的值
 158   1        Si24R1_Write_Reg(NRF_WRITE_REG+STATUS,sta);     //清除TX_DS或MAX_RT中断标志
 159   1        if(sta&MAX_TX)                    //达到最大重发次数
 160   1        {
 161   2          Si24R1_Write_Reg(FLUSH_TX,0xff);    //清除TX FIFO寄存器 
 162   2          return 2; 
 163   2        
 164   2        }
 165   1        
 166   1        if(sta&TX_OK)                     //发送完成
 167   1        {
 168   2      
 169   2          return 1;
 170   2        }
 171   1        
 172   1        return 0;                       //其他原因发送失败
 173   1      }
 174          
 175          
 176          //Si24R1接收一次数据
 177          //rxbuf:Si24R1接收一次数据
 178          //返回值:0，接收完成；其他，错误代码
C51 COMPILER V9.54   SI24R1                                                                12/13/2024 15:01:19 PAGE 4   

 179          uchar Si24R1_RxPacket(uchar *rxbuf)
 180          {
 181   1        uchar sta;                         
 182   1         
 183   1        sta=Si24R1_Read_Reg(STATUS);  //读取状态寄存器的值       
 184   1        Si24R1_Write_Reg(NRF_WRITE_REG+STATUS,sta); //清除TX_DS或MAX_RT中断标志
 185   1        if(sta&RX_OK)//接收到数据
 186   1        {
 187   2          
 188   2          Si24R1_Read_Buf(RD_RX_PLOAD,rxbuf,R_RX_PAYLOAD_WIDTH);//读取数据
 189   2          
 190   2          Si24R1_Write_Reg(FLUSH_RX,0xff);//清除RX FIFO寄存器 
 191   2          return 0; 
 192   2        }    
 193   1        return 1;//没收到任何数据
 194   1      }   
