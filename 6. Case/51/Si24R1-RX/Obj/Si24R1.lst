  67          //Si24R1写寄存器
  68          //SPI写寄存器
  69          //reg:指定寄存器地址
  70          //value:写入的值
  71          uchar Si24R1_Write_Reg(uchar reg,uchar value)
  72          {
  73   1        uchar status;
  74   1        CSN=0;      //使能SPI传输
  75   1        status=SW_SPI_ReadWriteByte(reg);   //读取寄存器内容
  76   1        SW_SPI_ReadWriteByte(value);  //写入寄存器的值
  77   1        CSN=1;     //SPI传输结束
  78   1      
  79   1        return(status);             //返回状态值
  80   1      }
  81          
  82          
  83          //Si24R1读寄存器
  84          //SPI写寄存器
  85          //reg:指定寄存器地址
  86          //value:写入的值
  87          uchar Si24R1_Read_Reg(uchar reg)
  88          {
  89   1        uchar reg_val;
  90   1        CSN=0;      //使能SPI传输
  91   1        SW_SPI_ReadWriteByte(reg);  //写入寄存器的值
  92   1        reg_val=SW_SPI_ReadWriteByte(NOP);  //空操作，用来读取状态寄存器
  93   1        CSN=1;     //SPI传输结束
  94   1      
  95   1        return reg_val;             //返回状态值
  96   1      }
  97          
