  40          //初始化IO口，软件SPI
  41          void init_io(void)
  42          {
  43   1          CE  = 0;        // 待机
  44   1          CSN = 1;        // SPI传输结束
  45   1          SCK = 0;        // SPI时钟置低
  46   1          IRQ = 1;        // 中断
  47   1          LED = 0;        // 关闭指示灯
  48   1      }
  49          
  50          
  51          uchar SW_SPI_ReadWriteByte(uchar byte)
  52          {
  53   1          uchar   bit_ctr;
  54   1          // output 8-bits
C51 COMPILER V9.54   SI24R1                                                                12/13/2024 15:01:19 PAGE 2   

  55   1          for (bit_ctr = 0; bit_ctr < 8; bit_ctr++)
  56   1          {
  57   2              MOSI = (byte & 0x80);   // output 'byte' MSB to MOSI
  58   2              byte = (byte << 1);     // shift next bit into MSB..
  59   2              SCK = 1;                // Set SCK high.. 24R1 read 1-bit from MOSI and output 1-bit to MISO 
  60   2              byte |= MISO;           // capture current MISO bit 
  61   2              SCK = 0;                // ..then set SCK low again
  62   2          }
  63   1      
  64   1          return (byte);  // return read byte
  65   1      }
