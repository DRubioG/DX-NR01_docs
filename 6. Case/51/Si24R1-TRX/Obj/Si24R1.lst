 147          //启动Si24R1发送一次数据
 148          //txbuf:待发送数据首地址
 149          //返回值:发送完成状况
 150          uchar Si24R1_TxPacket(uchar *txbuf)
 151          {
 152   1        uchar sta;
 153   1        CE=0;
 154   1        Si24R1_TX_Mode();
 155   1        Si24R1_Write_Buf(WR_TX_PLOAD,txbuf,W_RX_PAYLOAD_WIDTH); //写数据到TX BUF  32个字节
 156   1        CE=1;
 157   1          
 158   1        while(IRQ!=0);                           //数据发送完成中断
 159   1        sta=Si24R1_Read_Reg(STATUS);           //读取状态寄存器的值
 160   1        Si24R1_Write_Reg(NRF_WRITE_REG+STATUS,sta);     //清除TX_DS或MAX_RT中断标志
 161   1        Si24R1_RX_Mode();
 162   1        if(sta&MAX_TX)                    //达到最大重发次数
 163   1        {
 164   2          Si24R1_Write_Reg(FLUSH_TX,0xff);    //清除TX FIFO寄存器 
 165   2          return 2; 
 166   2        
 167   2        }
 168   1        
 169   1        if(sta&TX_OK)                     //发送完成
 170   1        {
 171   2      
 172   2          return 1;
 173   2        }
 174   1        
 175   1        return 0;                       //其他原因发送失败
 176   1      }
