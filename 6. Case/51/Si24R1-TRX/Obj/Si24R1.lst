 224          //Si24R1检测函数
 225          uchar Si24R1_Check(void)
 226          {
 227   1        uchar check_in_data[5]={0X55,0XAA,0X55,0XAA,0X55};
 228   1        uchar check_out_data[5]={0x00};
 229   1        
 230   1        CE=0;
 231   1        Si24R1_Write_Buf(NRF_WRITE_REG+TX_ADDR,check_in_data,5);
 232   1        Si24R1_Read_Buf(NRF_READ_REG+TX_ADDR,check_out_data,5);
 233   1        if( (check_out_data[0]==0x55)&&
 234   1          (check_out_data[1]==0xAA)&&
 235   1          (check_out_data[2]==0x55)&&
 236   1          (check_out_data[3]==0xAA)&&
 237   1          (check_out_data[4]==0x55))
 238   1          return 0;
 239   1        else
 240   1          return 1;
C51 COMPILER V9.54   SI24R1                                                                11/15/2024 11:11:27 PAGE 5   

 241   1      }
