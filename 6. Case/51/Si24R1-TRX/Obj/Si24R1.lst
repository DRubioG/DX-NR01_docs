 106          uchar Si24R1_Write_Buf(uchar reg, uchar *pBuf, uchar len)
 107          {
 108   1      
 109   1        uchar status,ctr;
 110   1        CSN=0;             //使能SPI传输          
 111   1        status=SW_SPI_ReadWriteByte(reg); //发送寄存器值(位置),并读取状态值
 112   1        for(ctr=0;ctr<len;ctr++)
 113   1        {
 114   2          SW_SPI_ReadWriteByte(*pBuf++);  //写入数据   
 115   2        
 116   2        
