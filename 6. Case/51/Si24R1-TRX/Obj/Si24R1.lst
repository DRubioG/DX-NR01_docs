  41          //初始化IO口，软件SPI
  42          void init_io(void)
  43          {
  44   1          CE  = 0;        // 待机
  45   1          CSN = 1;        // SPI传输结束
  46   1          SCK = 0;        // SPI时钟置低
  47   1          IRQ = 1;        // 中断
  48   1          LED = 0;        // 关闭指示灯
  49   1      }
  50          
  51          
  52          uchar SW_SPI_ReadWriteByte(uchar byte)
  53          {
  54   1          uchar   bit_ctr;
C51 COMPILER V9.54   SI24R1                                                                11/15/2024 11:11:27 PAGE 2   

  55   1          // output 8-bits
  56   1          for (bit_ctr = 0; bit_ctr < 8; bit_ctr++)
  57   1          {
  58   2              MOSI = (byte & 0x80);   // output 'byte' MSB to MOSI
  59   2              byte = (byte << 1);     // shift next bit into MSB..
  60   2              SCK = 1;                // Set SCK high.. 24R1 read 1-bit from MOSI and output 1-bit to MISO 
  61   2              byte |= MISO;           // capture current MISO bit 
  62   2              SCK = 0;                // ..then set SCK low again
  63   2          }
  64   1      
  65   1          return (byte);  // return read byte
  66   1      }
