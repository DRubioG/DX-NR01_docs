 179          //Si24R1接收一次数据
 180          //rxbuf:Si24R1接收一次数据
 181          //返回值:0，接收完成；其他，错误代码
 182          uchar Si24R1_RxPacket(uchar *rxbuf)
 183          {
 184   1        uchar sta;                         
 185   1         
 186   1        sta=Si24R1_Read_Reg(STATUS);  //读取状态寄存器的值       
 187   1        Si24R1_Write_Reg(NRF_WRITE_REG+STATUS,sta); //清除TX_DS或MAX_RT中断标志
 188   1        if(sta&RX_OK)//接收到数据
 189   1        {
 190   2          
 191   2          Si24R1_Read_Buf(RD_RX_PLOAD,rxbuf,R_RX_PAYLOAD_WIDTH);//读取数据
 192   2          
 193   2          Si24R1_Write_Reg(FLUSH_RX,0xff);//清除RX FIFO寄存器 
 194   2          return 0; 
 195   2        }    
 196   1        return 1;//没收到任何数据
 197   1      }   
