 199          //设置Si24R1为TX模式
 200          void Si24R1_TX_Mode(void)
 201          {
 202   1      
 203   1        CE=0;
 204   1        Si24R1_Write_Reg(NRF_WRITE_REG+CONFIG,0x0e);
 205   1          Si24R1_Write_Reg(FLUSH_RX,0xff);
 206   1        Si24R1_Write_Reg(FLUSH_TX,0xff);
 207   1        CE=1;
 208   1      
