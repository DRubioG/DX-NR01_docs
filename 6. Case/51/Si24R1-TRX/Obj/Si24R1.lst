  68          //Si24R1写寄存器
  69          //SPI写寄存器
  70          //reg:指定寄存器地址
  71          //value:写入的值
  72          uchar Si24R1_Write_Reg(uchar reg,uchar value)
  73          {
  74   1        uchar status;
  75   1        CSN=0;      //使能SPI传输
  76   1        status=SW_SPI_ReadWriteByte(reg);   //读取寄存器内容
  77   1        SW_SPI_ReadWriteByte(value);  //写入寄存器的值
  78   1        CSN=1;     //SPI传输结束
  79   1      
  80   1        return(status);             //返回状态值
  81   1      }
  82          
  83          
  84          //Si24R1读寄存器
  85          //SPI写寄存器
  86          //reg:指定寄存器地址
  87          //value:写入的值
  88          uchar Si24R1_Read_Reg(uchar reg)
  89          {
  90   1        uchar reg_val;
  91   1        CSN=0;      //使能SPI传输
  92   1        SW_SPI_ReadWriteByte(reg);  //写入寄存器的值
  93   1        reg_val=SW_SPI_ReadWriteByte(NOP);  //空操作，用来读取状态寄存器
  94   1        CSN=1;     //SPI传输结束
  95   1      
  96   1        return reg_val;             //返回状态值
  97   1      }
