 123          //Si24R1读数据
 124          //reg:寄存器(位置)
 125          //*pBuf:数据指针
 126          //len:数据长度
 127          //返回值,此次读到的状态寄存器值
 128          uchar Si24R1_Read_Buf(uchar reg, uchar *pBuf, uchar len)
 129          {
 130   1        uchar status,u8_ctr;
 131   1        CSN=0;  
