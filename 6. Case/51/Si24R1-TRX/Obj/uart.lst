  58          void UART_IRQn() interrupt 4
  59          {
  60   1        u8 r;
  61   1        
  62   1        if(RI)
  63   1        {
  64   2          RI=0;
  65   2          r=SBUF;//读取接收到的数据
  66   2          if((UART_RX_STA&0x8000)==0)//接收未完成
  67   2          {
  68   3            if(UART_RX_STA&0x4000)//接收到了0x0d
  69   3            {
  70   4              if(r!=0x0a)UART_RX_STA=0;//接收错误,重新开始
  71   4              else UART_RX_STA|=0x8000; //接收完成了 
  72   4            }
  73   3            else //还没收到0X0D
  74   3            { 
